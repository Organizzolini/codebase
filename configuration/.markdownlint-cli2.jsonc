{
  // Configuration for markdownlint-cli2
  // See: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    // Default state for all rules
    "default": true,
    // MD013: Line length - disabled (too restrictive for technical docs)
    "MD013": false,
    // MD024: Multiple headings with the same content - allow duplicate headings in different sections
    "MD024": {
      "siblings_only": true,
    },
    // MD033: Inline HTML - allow HTML for complex formatting
    "MD033": false,
    // MD034: Bare URL - allow bare URLs without angle brackets
    "MD034": false,
    // MD041: First line in file should be a top level heading - disabled for flexibility
    "MD041": false,
    // MD046: Code block style - enforce fenced code blocks
    "MD046": {
      "style": "fenced",
    },
    // MD049: Emphasis style - enforce underscore style (matches oxfmt/prettier output)
    "MD049": {
      "style": "underscore",
    },
    // MD050: Strong style - enforce asterisk style
    "MD050": {
      "style": "asterisk",
    },
  },
  // Fix mode configuration
  "fix": false,
  // Globs to ignore
  "ignores": [
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.terraform/**",
    "**/.venv/**",
    "**/.claude/worktrees/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    // Vendored upstream skills, one entry per skill in skills-lock.json, kept
    // close to the formatting their sources chose. Listed individually rather
    // than as ".agents/skills/**" so this repository's own skills in the same
    // directory keep being linted. Verified by
    // "nx run synchronization:synchronize", which also generates the block
    // below.
    // installed-skills-start
    ".agents/skills/ask-matt/**",
    ".agents/skills/brainstorming/**",
    ".agents/skills/callidescope-configure/**",
    ".agents/skills/callidescope-trace/**",
    ".agents/skills/callidescope-triage/**",
    ".agents/skills/code-review/**",
    ".agents/skills/codebase-design/**",
    ".agents/skills/codependix-configure/**",
    ".agents/skills/codependix-export/**",
    ".agents/skills/codependix-navigate/**",
    ".agents/skills/codependix-triage/**",
    ".agents/skills/codometer-configure/**",
    ".agents/skills/codometer-measure/**",
    ".agents/skills/codometer-triage/**",
    ".agents/skills/conformetry-configure/**",
    ".agents/skills/conformetry-generate/**",
    ".agents/skills/conformetry-validate/**",
    ".agents/skills/diagnosing-bugs/**",
    ".agents/skills/dispatching-parallel-agents/**",
    ".agents/skills/domain-modeling/**",
    ".agents/skills/finishing-a-development-branch/**",
    ".agents/skills/gh-stack/**",
    ".agents/skills/github-issues/**",
    ".agents/skills/grill-me/**",
    ".agents/skills/grill-with-docs/**",
    ".agents/skills/grilling/**",
    ".agents/skills/handoff/**",
    ".agents/skills/impeccable/**",
    ".agents/skills/implement/**",
    ".agents/skills/improve-codebase-architecture/**",
    ".agents/skills/link-workspace-packages/**",
    ".agents/skills/monitor-ci/**",
    ".agents/skills/nx-generate/**",
    ".agents/skills/nx-import/**",
    ".agents/skills/nx-plugins/**",
    ".agents/skills/nx-run-tasks/**",
    ".agents/skills/nx-workspace/**",
    ".agents/skills/prototype/**",
    ".agents/skills/receiving-code-review/**",
    ".agents/skills/requesting-code-review/**",
    ".agents/skills/research/**",
    ".agents/skills/setup-matt-pocock-skills/**",
    ".agents/skills/subagent-driven-development/**",
    ".agents/skills/systematic-debugging/**",
    ".agents/skills/tdd/**",
    ".agents/skills/teach/**",
    ".agents/skills/test-driven-development/**",
    ".agents/skills/to-questionnaire/**",
    ".agents/skills/to-spec/**",
    ".agents/skills/to-tickets/**",
    ".agents/skills/triage/**",
    ".agents/skills/using-git-worktrees/**",
    ".agents/skills/verification-before-completion/**",
    ".agents/skills/wait-what/**",
    ".agents/skills/wayfinder/**",
    ".agents/skills/wizard/**",
    ".agents/skills/writing-for-agents/**",
    ".agents/skills/writing-skills/**",
    // installed-skills-end
    ".conformetry/**",
    ".nx/**",
    "applications/affirmations/output/**",
    "applications/meanderaw/output/**",
    "applications/lexico-ingestion/data/library/**",
    // Auto-generated by semantic-release — list style may differ from handwritten docs
    "CHANGELOG.md",
    "coverage/**",
    "dist/**",
    "documentation/planning/**",
    "node_modules/**",
    "packages/lexico-components/src/components/**",
    "packages/lexico-components/src/hooks/use-mobile.tsx",
    "packages/lexico-components/src/lib/utils.ts",
    "pnpm-lock.yaml",
  ],
}
