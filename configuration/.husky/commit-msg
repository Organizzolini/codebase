# shellcheck shell=sh
# Husky runs hooks with sh, so there is no shebang.

printf '[%s] commit-msg\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"

# commitlint is invoked directly rather than through `nx run codebase:commitlint`.
# That target is `cache: false`, so Nx contributed nothing but a project graph
# build — measured at ~1.4s on every commit, against ~0.1s for the binary.
# Husky puts node_modules/.bin on PATH, which is how `nx` resolved here before.
NODE_OPTIONS='--import=tsx' commitlint \
  --config configuration/commitlint.config.ts \
  --edit "$1"
