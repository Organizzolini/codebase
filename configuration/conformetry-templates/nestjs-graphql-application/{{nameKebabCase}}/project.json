{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/{{nameKebabCase}}",
  "tags": [
    "framework:nestjs",
    "generator:nestjs-graphql-application",
    "language:graphql",
    "language:typescript"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "description": "Start the {{namePascalCase}} GraphQL API",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/{{nameKebabCase}}.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {},
    "typecheck-code": {},
    "format-code": {},
    "deprecate-code": {},
    "guard-code": {}
  }
}
