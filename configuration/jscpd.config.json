{
  "gitignore": true,
  "ignore": [
    "**/.agents/skills/**",
    "**/.claude/skills/**",
    "**/.conformetry/**",
    "**/.git/**",
    "**/.github/skills/**",
    "**/.nx/**",
    "**/conformetry-templates/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/notepads/**",
    "**/output/**",
    "**/packages/ic-suite/codometer/codometer-examples/examples/compiled/**",
    "**/packages/ic-suite/codometer/codometer-examples/examples/corpus/**",
    "**/packages/ic-suite/conformetry/conformetry-examples/examples/*/instances/**",
    "**/packages/ic-suite/conformetry/conformetry-examples/examples/*/templates/**",
    "**/pnpm-lock.yaml",
    "**/src/**/*.constants.ts",
    "**/src/**/*.types.ts",
    "**/testing/mocks.ts",
    "**/tmp/**",
    "packages/ic-suite/callidescope/callidescope-examples/**"
  ],
  "minLines": 12,
  "minTokens": 24,
  "mode": "mild",
  "reporters": ["console", "threshold"],
  "threshold": 6
}
