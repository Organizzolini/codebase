  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "2.87.3"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "helm": "4.1.1",
      "minikube": "1.38.1",
      "version": "1.35.1"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "nvmVersion": "latest",
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "enableShared": true,
      "installJupyterlab": true,
      "installTools": true,
      "optimize": true,
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "installTerraformLS": false,
      "installTFsec": false,
      "tflint": "0.61.0",
      "version": "1.14.5"
    },
    "ghcr.io/devcontainers-extra/features/nx-npm:1": {
      "version": "22.7.3"
    },
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "11.2.2"
    },
    "ghcr.io/devcontainers-extra/features/supabase-cli:1": {
      "version": "2.76.8"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {
      "version": "latest"
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {
      "gojqVersion": "none",
      "jaqVersion": "none",
      "jqVersion": "1.8.1",
      "xqVersion": "none",
      "yqVersion": "none"
    },
    "ghcr.io/warrenbuckley/codespace-features/sqlite:1": {
      "version": "3.40.1"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true,
      "moby": false,
      "version": "latest"
    }
  },
  "dockerComposeFile": [
    "../../infrastructure/docker/docker-compose.yml",
    "docker-compose.yml"
  ],
  "forwardPorts": [3000, 3001, 8889, 11434, 54321, 54322, 54323, 54324, 54325],
  "name": "Codebase Devcontainer (Local)",
  "portsAttributes": {
    "3000": {
      "label": "Lexico Development Server",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "Open WebUI",
      "onAutoForward": "notify"
    },
    "8889": {
      "label": "SearxNG",
      "onAutoForward": "notify"
    },
    "11434": {
      "label": "Ollama API",
      "onAutoForward": "silent"
    },
    "54321": {
      "label": "Supabase API (PostgREST)",
      "onAutoForward": "silent"
    },
    "54322": {
      "label": "Supabase PostgreSQL",
      "onAutoForward": "silent"
    },
    "54323": {
      "label": "Supabase Studio",
      "onAutoForward": "notify"
    },
    "54324": {
      "label": "Supabase Inbucket (Email)",
      "onAutoForward": "silent"
    },
    "54325": {
      "label": "Supabase Analytics",
      "onAutoForward": "silent"
    }
  },
  "initializeCommand": ".devcontainer/scripts/initialize-command.sh",
  "postAttachCommand": ".devcontainer/scripts/post-attach-command.sh",
  "postCreateCommand": ".devcontainer/scripts/post-create-command.sh",
  "remoteEnv": {
    "GITLEAKS_VERSION": "8.30.1",
    "KUBECONFIG": "${containerWorkspaceFolder}/.kube/config",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "CODEBASE_ENVIRONMENT": "devcontainer-local",
    "NODE_OPTIONS": "--max-old-space-size=2048",
    "OLLAMA_HOST": "http://host.docker.internal:11434",
    "SEARXNG_HOST": "http://searxng:8080",
    "TRIVY_VERSION": "0.74.0",
    "UV_VERSION": "0.12.3",
    "UV_THREADPOOL_SIZE": "4",
    "VSCODE_EXTENSION_HOST_WORKER_CONCURRENCY": "4"
  },
  "remoteUser": "root",
  "runServices": ["devcontainer"],
  "service": "devcontainer",
  "shutdownAction": "stopCompose",
  "waitFor": "postCreateCommand",
  "workspaceFolder": "/workspaces/codebase"
}
