{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "caelundas-cli",
  "projectType": "application",
  "sourceRoot": "applications/caelundas/caelundas-cli",
  "tags": [
    "domain:caelundas",
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "applications/caelundas/caelundas-cli",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "applications/caelundas/caelundas-cli/src/main.ts",
        "outputPath": "applications/caelundas/caelundas-cli/dist",
        "tsConfig": "applications/caelundas/caelundas-cli/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "download-ephemeris": {
      "cache": false,
      "description": "Download Swiss Ephemeris data files to data/ephemeris/",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsx scripts/download-ephemeris.ts",
        "cwd": "{projectRoot}"
      }
    },
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {
      "cache": false,
      "description": "Start an interactive NestJS REPL for Caelundas services",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/repl.ts",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "caelundas": {
          "command": "node --import @swc-node/register/esm-register src/main.ts caelundas {args}"
        }
      },
      "defaultConfiguration": "caelundas",
      "description": "Start the Caelundas application",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/main.ts caelundas {args}",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
