{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "bail": false,
  "cacheDirectory": ".nx/cache",
  "defaultBase": "main",
  "defaultProject": "codebase",
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "bundler": "vite",
        "linter": "eslint",
        "style": "tailwind"
      },
      "component": {
        "style": "tailwind"
      },
      "library": {
        "linter": "eslint",
        "style": "tailwind"
      }
    }
  },
  "namedInputs": {
    "default": [
      "!{projectRoot}/.eslintcache/**",
      "{projectRoot}/**/*",
      "shared-globals"
    ],
    "dependency-versions": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "production": [
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "default"
    ],
    "python-source": [
      "{projectRoot}/**/*.ipynb",
      "{projectRoot}/**/*.py",
      "{projectRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ],
    "python-tests": ["{projectRoot}/testing/**/*.py"],
    "shared-globals": ["{workspaceRoot}/configuration/tsconfig.json"],
    "typescript-files": [
      "{projectRoot}/**/*.{ts,tsx,mts,cts}",
      "{projectRoot}/**/*.json",
      "{projectRoot}/tsconfig*.json",
      "shared-globals"
    ]
  },
  "neverConnectToCloud": true,
  "parallel": 2,
  "plugins": [
    {
      "options": {
        "buildTargetName": "build",
        "devTargetName": "develop",
        "typecheckTargetName": "typecheck"
      },
      "plugin": "@nx/vite/plugin"
    },
    {
      "options": {
        "targetName": "eslint"
      },
      "plugin": "@nx/eslint/plugin"
    },
    {
      "options": {
        "testMode": "run",
        "testTargetName": "vitest"
      },
      "plugin": "@nx/vitest"
    },
    {
      "options": {
        "configurationPath": "configuration/conformetry.config.ts",
        "validateTargetName": "conformetry-validate"
      },
      "plugin": "@conformetry/nx"
    },
    {
      "options": {
        "configurationPath": "configuration/callidescope.config.ts",
        "gateTargetName": "callidescope-gate"
      },
      "plugin": "@callidescope/nx"
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "projects": {
    "caelundas-cli": {
      "tags": ["domain:caelundas", "language:typescript", "type:application"]
    },
    "codebase": {
      "tags": ["language:typescript", "type:tool"]
    }
  },
  "release": {
    "changelog": {
      "projectChangelogs": {
        "createRelease": false,
        "file": "{projectRoot}/CHANGELOG.md",
        "renderOptions": {
          "authors": false,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "workspaceChangelog": false
    },
    "conventionalCommits": {
      "types": {
        "build": {
          "changelog": {
            "hidden": false
          },
          "semverBump": "patch"
        },
        "perf": {
          "semverBump": "patch"
        },
        "refactor": {
          "changelog": {
            "hidden": false
          },
          "semverBump": "patch"
        }
      }
    },
    "git": {
      "commit": false,
      "push": false,
      "tag": false
    },
    "projects": [
      "packages/ic-suite/*/*",
      "!callidescope-agents",
      "!callidescope-examples",
      "!codependix-agents",
      "!codependix-examples",
      "!codometer-agents",
      "!codometer-examples",
      "!conformetry-agents",
      "!conformetry-examples"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "specifierSource": "conventional-commits",
      "updateDependents": "auto"
    }
  },
  "sync": {
    "globalGenerators": ["@conformetry/nx:sync"]
  },
  "targetDefaults": {
    "bandit": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run bandit -c pyproject.toml -r src/",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "build": [
      {
        "cache": true,
        "dependsOn": ["^build"],
        "filter": {
          "projects": ["tag:language:python", "tag:language:typescript"]
        },
        "inputs": ["^production", "dependency-versions", "production"]
      }
    ],
    "build-projects": {
      "cache": false,
      "dependsOn": ["build", "codometer"],
      "description": "Build every buildable project and measure it. An nx:noop aggregator; `build` carries its own ^build dependency, and `codometer` gates each project's declared limit.",
      "executor": "nx:noop"
    },
    "codometer": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "node --import @swc-node/register/esm-register ../../packages/ic-suite/codometer/codometer-cli/src/main.ts measure --output-json --check limits"
          },
          "write": {
            "command": "node --import @swc-node/register/esm-register ../../packages/ic-suite/codometer/codometer-cli/src/main.ts measure --output-json --output-markdown README.md"
          }
        },
        "defaultConfiguration": "check",
        "dependsOn": ["build"],
        "description": "Measure one project and gate the limit it declares, writing the report the pull request's ⏲️ Codometer section reads. This default depends on `build` because size analysis reads compiled output; the workspace-root `codebase:codometer` target must NOT, because it measures source and waiting on every build would be both slow and circular — it pins `dependsOn` to an empty list of its own so this default can never reach it, and neither half of that asymmetry may be collapsed into the other. The command runs with `cwd` set to `{projectRoot}` rather than the workspace root: codometer has no `--directory` flag of its own and always measures the process's own working directory, so running there is what makes a project's `limits[]` address paths like `Compiled JavaScript.size` rather than ones synthesized under a `Command Line` input, and it is also what lets `--config`'s upward-ancestor search land on the project's own `codometer.config.ts` instead of the workspace one. `main.ts` is addressed with a literal `../../` rather than `{workspaceRoot}` for the same reason — the working directory it runs from is no longer the workspace root, and Nx only resolves the `{workspaceRoot}` token when it opens the whole option's value, not when it appears partway through one; this entry reaches every project that sits exactly two directories below the workspace root, which is every project except the ones nested under `packages/ic-suite/<suite>/`, whose own four-directories-deep override sits below. `SWC_NODE_PROJECT` is pinned the same way, to the shared base every project's own tsconfig already extends: `@swc-node/register`'s ESM hook resolves its tsconfig as `<cwd>/tsconfig.json` with no upward search, so a project with no `tsconfig.json` of its own — `affirmancy`, which is pure Python — would otherwise fail to load `codometer-cli` at all rather than measure anything, the same way `codometer-cli`'s own `start` target already pins this for the same hook. `--output-json` is a bare flag rather than a path, so it writes wherever the resolved configuration's own `json` output says to — the shared configuration's `codometer-report.json`, the same path for every project — and a target that left the flag off would write nothing at all and still exit clean — contributing nothing to the ⏲️ Codometer section and looking exactly like a project that changed nothing — so passing it is what makes the report exist, not something the tool refuses to run without. `--output-markdown README.md` stays a literal path on the command line because only the `write` configuration passes it, which is what keeps a branch's `check` run from rewriting every project README; `check` adds `--check limits` so a breach fails only after the report is on disk. Neither checks staleness: project READMEs are written on main by the release workflow, so they are expected to be stale on a branch. The report this target writes is subtracted from its own inputs, because `production` would otherwise glob it back in and every run would rewrite the hash it was just cached under — a local run could never hit its own cache, and a fresh checkout could never match one. `README.md` stays an input despite also being an output: codometer measures markdown, so an edit to it genuinely changes the measurement, and restoring it from cache writes back the identical bytes.",
        "executor": "nx:run-commands",
        "inputs": [
          "!{projectRoot}/codometer-report.json",
          "^production",
          "{workspaceRoot}/configuration/.codometerignore",
          "{workspaceRoot}/configuration/codometer.config.ts",
          "production"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "../../configuration/tsconfig.json"
          }
        },
        "outputs": [
          "{projectRoot}/codometer-report.json",
          "{projectRoot}/README.md"
        ]
      },
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "node --import @swc-node/register/esm-register ../../../../packages/ic-suite/codometer/codometer-cli/src/main.ts measure --output-json --check limits"
          },
          "write": {
            "command": "node --import @swc-node/register/esm-register ../../../../packages/ic-suite/codometer/codometer-cli/src/main.ts measure --output-json --output-markdown README.md"
          }
        },
        "defaultConfiguration": "check",
        "dependsOn": ["build"],
        "description": "The `packages/ic-suite/<suite>/` override of the default `codometer` entry above: every field is identical except the two relative paths, corrected from two directories below the workspace root to four. Kept as a full second entry rather than a partial one because Nx does not merge across matching targetDefaults array entries — the last one whose `filter` matches a project replaces the earlier entry wholesale for that project, so a partial override would silently drop the fields it left out.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": [
            "callidescope-agents",
            "callidescope-cli",
            "callidescope-configuration",
            "callidescope-core",
            "callidescope-examples",
            "callidescope-graph",
            "callidescope-nx",
            "callidescope-output",
            "codependix-agents",
            "codependix-boundaries",
            "codependix-cli",
            "codependix-configuration",
            "codependix-core",
            "codependix-examples",
            "codependix-file-imports",
            "codependix-nestjs-modules",
            "codependix-nx-projects",
            "codependix-output",
            "codometer-agents",
            "codometer-cli",
            "codometer-configuration",
            "codometer-core",
            "codometer-examples",
            "codometer-languages",
            "codometer-measurement",
            "codometer-output",
            "conformetry-agents",
            "conformetry-cli",
            "conformetry-configuration",
            "conformetry-core",
            "conformetry-examples",
            "conformetry-generation",
            "conformetry-languages",
            "conformetry-nx",
            "conformetry-output",
            "conformetry-validation"
          ]
        },
        "inputs": [
          "!{projectRoot}/codometer-report.json",
          "^production",
          "{workspaceRoot}/configuration/.codometerignore",
          "{workspaceRoot}/configuration/codometer.config.ts",
          "production"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "../../../../configuration/tsconfig.json"
          }
        },
        "outputs": [
          "{projectRoot}/codometer-report.json",
          "{projectRoot}/README.md"
        ]
      },
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "node --import @swc-node/register/esm-register ../../../packages/ic-suite/codometer/codometer-cli/src/main.ts measure --output-json --check limits"
          },
          "write": {
            "command": "node --import @swc-node/register/esm-register ../../../packages/ic-suite/codometer/codometer-cli/src/main.ts measure --output-json --output-markdown README.md"
          }
        },
        "defaultConfiguration": "check",
        "dependsOn": ["build"],
        "description": "The `applications/<domain>/` override of the default `codometer` entry above: every field is identical except the two relative paths, corrected from two directories below the workspace root to three. A full entry for the same reason as the `packages/ic-suite/<suite>/` one: Nx replaces a matching targetDefaults array entry wholesale rather than merging it.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": [
            "caelundas-cli",
            "lexico-api",
            "lexico-cli",
            "lexico-web",
            "meanderaw-cli"
          ]
        },
        "inputs": [
          "!{projectRoot}/codometer-report.json",
          "^production",
          "{workspaceRoot}/configuration/.codometerignore",
          "{workspaceRoot}/configuration/codometer.config.ts",
          "production"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "SWC_NODE_PROJECT": "../../../configuration/tsconfig.json"
          }
        },
        "outputs": [
          "{projectRoot}/codometer-report.json",
          "{projectRoot}/README.md"
        ]
      }
    ],
    "dependency-cruiser": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "^default",
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.tsx",
          "{workspaceRoot}/configuration/dependency-cruiser.cjs",
          "default",
          {
            "externalDependencies": ["dependency-cruiser"]
          }
        ],
        "options": {
          "command": "depcruise {projectRoot}/src --config configuration/dependency-cruiser.cjs",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "deprecate-code": {
      "cache": false,
      "configurations": {
        "check": {},
        "write": {}
      },
      "defaultConfiguration": "check",
      "dependsOn": [
        "dependency-cruiser",
        "fallow-dead-code",
        "knip",
        "nbstripout",
        "sherif",
        "squawk",
        "syncpack",
        "vulture"
      ],
      "description": "Aggregator for deprecate-code",
      "executor": "nx:noop"
    },
    "eslint": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "eslint . --cache --cache-strategy content --cache-location \"$NX_WORKSPACE_ROOT/.eslintcache/\""
          },
          "write": {
            "args": "--fix"
          }
        },
        "defaultConfiguration": "check",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "!{projectRoot}/.eslintcache/**",
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc,json5,html,css,scss,md,mdx,yaml,yml}",
          "{workspaceRoot}/configuration/codebase-structure.json",
          "{workspaceRoot}/configuration/eslint.config.ts",
          "shared-globals",
          {
            "externalDependencies": [
              "@eslint/js",
              "@eslint/markdown",
              "@eslint-react/eslint-plugin",
              "@nx/eslint-plugin",
              "@vitest/eslint-plugin",
              "eslint",
              "eslint-config-prettier",
              "eslint-plugin-better-max-params",
              "eslint-plugin-import-x",
              "eslint-plugin-jsdoc",
              "eslint-plugin-jsonc",
              "eslint-plugin-jsx-a11y",
              "eslint-plugin-perfectionist",
              "eslint-plugin-project-structure",
              "eslint-plugin-tsdoc",
              "eslint-plugin-unicorn",
              "eslint-plugin-yml",
              "typescript",
              "typescript-eslint"
            ]
          }
        ],
        "options": {
          "command": "eslint . {args}"
        }
      }
    ],
    "fallow": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow is meant to run per-project; until then the root-level fallow targets in the codebase project's own project.json, which scan the whole repository, are what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-audit": [
      {
        "cache": false,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-audit target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-audit is meant to run per-project; until then the root-level fallow-audit target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-dead-code": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-dead-code target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-dead-code is meant to run per-project; until then the root-level fallow-dead-code target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-duplicates": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-duplicates target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-duplicates is meant to run per-project; until then the root-level fallow-duplicates target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-health": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-health target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-health is meant to run per-project; until then the root-level fallow-health target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "format-code": {
      "cache": false,
      "configurations": {
        "check": {},
        "write": {}
      },
      "defaultConfiguration": "check",
      "dependsOn": [
        "markdown-lint",
        "oxfmt",
        "ruff-format",
        "spell-check",
        "sqlfluff-format",
        "yaml-lint"
      ],
      "description": "Aggregator for format-code",
      "executor": "nx:noop"
    },
    "guard-code": {
      "cache": false,
      "configurations": {
        "check": {},
        "write": {}
      },
      "defaultConfiguration": "check",
      "dependsOn": [
        "callidescope-gate",
        "check-catalog-manifests",
        {
          "projects": ["codebase"],
          "target": "codependix"
        },
        "check-lockfile",
        "check-readme-projects",
        "conformetry-validate",
        "sync-vscode-extensions"
      ],
      "description": "Aggregator for guard-code. `callidescope-gate` is callidescope's inferred per-project call-stack gate; it has no configurations, so the one `guard-code` is run with falls through to its defaults. `codependix` is pinned to the `codebase` project so every project's guard reaches the one workspace-wide boundary check, which Nx runs once however many projects are affected; `check` forwards to its `--check boundaries`.",
      "executor": "nx:noop"
    },
    "knip": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "knip --config configuration/knip.config.ts --workspace {projectRoot}"
          },
          "write": {
            "command": "knip --fix --config configuration/knip.config.ts --workspace {projectRoot}"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{workspaceRoot}/configuration/knip.config.ts",
          "default",
          {
            "externalDependencies": ["knip", "typescript"]
          }
        ],
        "options": {
          "command": "knip --config configuration/knip.config.ts --workspace {projectRoot}",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "lint-code": {
      "cache": false,
      "configurations": {
        "check": {},
        "write": {}
      },
      "defaultConfiguration": "check",
      "dependsOn": [
        "eslint",
        "oxlint",
        "ruff-lint",
        "shellcheck",
        "sqlfluff-lint",
        "stylelint"
      ],
      "description": "Aggregator for lint-code",
      "executor": "nx:noop"
    },
    "markdown-lint": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "markdownlint-cli2 --config configuration/.markdownlint-cli2.jsonc '{projectRoot}/**/*.md'"
          },
          "write": {
            "command": "markdownlint-cli2 --fix --config configuration/.markdownlint-cli2.jsonc '{projectRoot}/**/*.md'"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python", "tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.md",
          "{workspaceRoot}/configuration/.markdownlint-cli2.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["markdownlint-cli2"]
          }
        ],
        "options": {
          "command": "markdownlint-cli2 --config configuration/.markdownlint-cli2.jsonc '{projectRoot}/**/*.md'",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "migration": {
      "cache": false,
      "configurations": {
        "extract-sql-all": {
          "command": "test -n \"{args.module}\" || { echo 'migration: set options.module to the project database module folder, for example src/modules/<project>-database' >&2; exit 1; } && pnpm exec tsx packages/database/scripts/extract-migration-sql.ts --directory={projectRoot}/{args.module}/migrations --mode=all",
          "cwd": "{workspaceRoot}"
        },
        "extract-sql-latest": {
          "command": "test -n \"{args.module}\" || { echo 'migration: set options.module to the project database module folder, for example src/modules/<project>-database' >&2; exit 1; } && pnpm exec tsx packages/database/scripts/extract-migration-sql.ts --directory={projectRoot}/{args.module}/migrations --mode=latest",
          "cwd": "{workspaceRoot}"
        },
        "generate": {
          "commands": [
            "test -n \"{args.module}\" || { echo 'migration: set options.module to the project database module folder, for example src/modules/<project>-database' >&2; exit 1; } && node --import @swc-node/register/esm-register node_modules/typeorm/cli.js migration:generate {args.module}/migrations/migration -d {args.module}/data-source.constants.ts",
            "nx run {projectName}:migration:extract-sql-latest",
            "nx run {projectName}:lint-code:write",
            "nx run {projectName}:format-code:write"
          ],
          "parallel": false
        },
        "revert": {
          "command": "test -n \"{args.module}\" || { echo 'migration: set options.module to the project database module folder, for example src/modules/<project>-database' >&2; exit 1; } && node --import @swc-node/register/esm-register node_modules/typeorm/cli.js migration:revert -d {args.module}/data-source.constants.ts"
        },
        "run": {
          "command": "test -n \"{args.module}\" || { echo 'migration: set options.module to the project database module folder, for example src/modules/<project>-database' >&2; exit 1; } && node --import @swc-node/register/esm-register node_modules/typeorm/cli.js migration:run -d {args.module}/data-source.constants.ts"
        },
        "show": {
          "command": "test -n \"{args.module}\" || { echo 'migration: set options.module to the project database module folder, for example src/modules/<project>-database' >&2; exit 1; } && node --import @swc-node/register/esm-register node_modules/typeorm/cli.js migration:show -d {args.module}/data-source.constants.ts"
        }
      },
      "description": "Generate, run, revert, or show a database project's TypeORM migrations, or extract their SQL for sqlfluff and squawk. A project opts in with `\"migration\": { \"options\": { \"module\": \"src/modules/<project>-database\" } }`, naming the folder of its own database module, which holds the command-line data source at `data-source.constants.ts` and the migrations under `migrations/`; every configuration fails with a message when it is unset. Extra command-line flags are not forwarded to the commands. Never cached: every configuration reads or changes a live database.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "forwardAllArgs": false
      }
    },
