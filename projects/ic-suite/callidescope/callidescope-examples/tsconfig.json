{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@golevelup/ts-vitest": [
        "./node_modules/@golevelup/ts-vitest/lib/index.d.ts"
      ],
      "codebase/configuration/*": ["../../../../configuration/*"],
      "eslint-plugin-better-max-params": [
        "../../../../configuration/types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "target": "esnext",
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["dist", "node_modules", "output"],
  "extends": "../../../../configuration/tsconfig.json",
  "include": [
    "callidescope.config.ts",
    "callidescope.workspace.config.ts",
    "codependix.config.ts",
    "codometer.config.ts",
    "eslint.config.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "testing/**/*.ts",
    "vitest.config.ts"
  ]
}
