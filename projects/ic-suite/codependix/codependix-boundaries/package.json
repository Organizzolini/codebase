{
  "author": "Jimmy Paolini",
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@codependix/configuration": "workspace:*",
    "@codependix/core": "workspace:*",
    "@codependix/file-imports": "workspace:*",
    "@codependix/nestjs-modules": "workspace:*",
    "@codependix/nx-projects": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "reflect-metadata": "catalog:"
  },
  "description": "Boundary rule validation, forbid/allow rule enforcement, and cycle detection for Codependix graphs",
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/projects/ic-suite/codependix/codependix-boundaries#readme",
  "keywords": [
    "boundaries",
    "codependix",
    "cycle-detection",
    "linting",
    "rule-enforcement"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@codependix/boundaries",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "projects/ic-suite/codependix/codependix-boundaries",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.6"
}
