{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["codometer-cli"],
  "name": "codometer-examples",
  "projectType": "library",
  "sourceRoot": "projects/ic-suite/codometer/codometer-examples",
  "tags": ["language:typescript", "name:codometer-examples", "type:package"],
  "targets": {
    "build-projects": {},
    "codometer": {},
    "deprecate-code": {},
    "examples": {
      "cache": true,
      "description": "Run every example this package ships, the way its own guide says to, and gate on the exit code that guide promises. This is the smoke gate over all of it — `vitest` is where the numbers and the refusal messages are asserted, in the prose that explains them. It also holds the two completeness checks no assertion about output would catch: a configuration with no expected exit code, and an example directory with no `README.md`.",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/examples/**",
        "default"
      ],
      "options": {
        "command": "node --import @swc-node/register/esm-register testing/run-examples.ts",
        "cwd": "{projectRoot}"
      },
      "outputs": []
    },
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "pack": {},
    "prettier": {},
    "spell-check": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
