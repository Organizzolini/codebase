  "targets": {
    "ambiguous-attribution": {
      "cache": false,
      "description": "Show one path two templates explain unequally, then one they tie on. Exits non-zero: the tie is reported as an ambiguous instance",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --import @swc-node/register/esm-register projects/ic-suite/conformetry/conformetry-cli/src/main.ts templates --config projects/ic-suite/conformetry/conformetry-examples/examples/ambiguous-attribution/conformetry.config.ts --instances projects/ic-suite/conformetry/conformetry-examples/examples/ambiguous-attribution/instances/guide",
          "node --import @swc-node/register/esm-register projects/ic-suite/conformetry/conformetry-cli/src/main.ts templates --config projects/ic-suite/conformetry/conformetry-examples/examples/ambiguous-attribution/conformetry.config.ts --instances projects/ic-suite/conformetry/conformetry-examples/examples/ambiguous-attribution/instances/atlas",
          "node --import @swc-node/register/esm-register projects/ic-suite/conformetry/conformetry-cli/src/main.ts validate --config projects/ic-suite/conformetry/conformetry-examples/examples/ambiguous-attribution/conformetry.config.ts"
        ],
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "projects/ic-suite/conformetry/conformetry-cli/tsconfig.json"
        },
        "parallel": false
      }
    },
    "build-projects": {},
    "case-variants": {
      "cache": false,
      "description": "Validate an instance whose paths and contents use all four derived case variants, one of them overridden",
