{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["conformetry-cli"],
  "name": "conformetry-examples",
  "projectType": "library",
  "sourceRoot": "projects/ic-suite/conformetry/conformetry-examples",
