# 🌱 Environment
GH_TOKEN="<GH_TOKEN>"
GITHUB_TOKEN="<GITHUB_TOKEN>"
CODEBASE_ENVIRONMENT="local"
TF_VAR_linode_kubernetes_engine_cluster_id=""
TF_VAR_linode_token=""

# 🐳 Service URLs (defaults for local development; devcontainer overrides via remoteEnv)
OLLAMA_HOST="http://localhost:11434"
SEARXNG_HOST="http://localhost:8889"

# 🐘 PostgreSQL
# The shared container's admin login, for its healthcheck, its init script,
# and the root `postgres-data` targets. No application reads these: each
# reads its own `<PROJECT>_POSTGRES_*`, defaulted from its name by
# `@codebase/database`.
POSTGRES_DB="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"

# 📚 OpenWiki
GEMINI_API_KEY="<GEMINI_API_KEY>"
OPENWIKI_MODEL="gemini-3.5-flash-lite"
OPENWIKI_PROVIDER="gemini"
OPENWIKI_TELEMETRY_DISABLED="true"
