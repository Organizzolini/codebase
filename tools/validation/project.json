{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "validation",
  "projectType": "application",
  "sourceRoot": "tools/validation",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "pack": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "audit-governance": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts audit-governance"
        },
        "audit-issues": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts issue-metadata --all"
        },
        "catalog-manifests": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts catalog-manifests"
        },
        "issue-metadata": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts issue-metadata"
        },
        "lockfile": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts lockfile"
        },
        "publishable-packages": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts publishable-packages"
        },
        "pull-request-body": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts pull-request-body"
        },
        "pull-request-metadata": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts pull-request-metadata"
        },
        "readme-projects": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts readme-projects"
        }
      },
      "description": "Run one validation check by name.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/validation/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "verify-publishable-packages": {
      "cache": false,
      "dependsOn": [
        {
          "projects": ["tag:layer:*"],
          "target": "pack"
        }
      ],
      "description": "Pack every publishable ic-suite package, install the tarballs into a consumer outside the workspace, and check its imports, command lines, project graph, and one inferred target per Nx plugin. Every publishable ic-suite package, and only those, carries a layer:* tag; the *-agents and *-examples packages deliberately do not. Never publishes.",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run validation:start:publishable-packages",
        "cwd": "{workspaceRoot}"
      }
    },
    "yaml-lint": {}
  }
}
