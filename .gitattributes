# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.toml text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.db binary
*.sqlite binary

# Jupyter notebooks — strip outputs on commit to prevent large diffs
*.ipynb filter=nbstripout diff=ipynb

# Lockfile handling — treat as generated, non-diffable
pnpm-lock.yaml -diff linguist-generated

# Mark generated/vendored files for GitHub Linguist
*.d.cts linguist-generated
*.d.ts linguist-generated
coverage/** linguist-generated
.nx/** linguist-generated
dist/** linguist-generated

# Generated meanders, and the index page listing them. Unlike every other
# application's output these are committed, so that a change to the generator
# shows up as a reviewable diff of the drawings it produces — but they are
# drawings, not authored source. Left unmarked, the mosaic tile sweep alone is
# three thousand SVGs and would dominate the language bar, and the index page
# would add most of a megabyte of HTML nobody wrote. Diffs stay collapsed by
# default, which is what makes a three-thousand-file regeneration reviewable at
# all.
applications/meanderaw/output/** linguist-generated

# Installed agent skills — vendored from other repositories and committed so a
# fresh worktree has them, so Linguist should not count them as this
# repository's code. One of them ships half a megabyte of bundled browser
# JavaScript, which would otherwise dominate the language bar. Diffs stay
# visible on purpose: `skills update` lands upstream changes as a reviewable
# pull request. One entry per skill in skills-lock.json, verified by
# `nx run synchronization:synchronize`, which
# also generates the block below.
.agents/licenses/** linguist-vendored
