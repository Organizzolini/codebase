{
  "author": "Jimmy Paolini",
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@codometer/configuration": "workspace:*",
    "@codometer/core": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "mdast": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postcss": "catalog:",
    "reflect-metadata": "catalog:",
    "remark": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "description": "Language parsers and comment analyzers across TypeScript, JSON, Markdown, Python, and SQL for Codometer",
  "devDependencies": {
    "@codebase/logging": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/codometer/codometer-languages#readme",
  "keywords": [
    "ast",
    "code-metrics",
    "codometer",
    "comment-analysis",
    "languages",
    "parsers"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@codometer/languages",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "packages/ic-suite/codometer/codometer-languages",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.9"
}
