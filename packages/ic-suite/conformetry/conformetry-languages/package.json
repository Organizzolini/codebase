{
  "author": "Jimmy Paolini",
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@conformetry/configuration": "workspace:*",
    "@conformetry/core": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "jsonc-parser": "catalog:",
    "mdast-util-to-string": "catalog:",
    "reflect-metadata": "catalog:",
    "remark": "catalog:",
    "remark-gfm": "catalog:",
    "typescript": "catalog:"
  },
  "description": "Multi-language file comparison and syntax validators for Conformetry",
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/conformetry/conformetry-languages#readme",
  "keywords": [
    "comparison",
    "conformetry",
    "json",
    "languages",
    "markdown",
    "python",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@conformetry/languages",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "packages/ic-suite/conformetry/conformetry-languages",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.4"
}
