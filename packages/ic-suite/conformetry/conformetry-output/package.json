{
  "author": "Jimmy Paolini",
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@conformetry/core": "workspace:*",
    "@conformetry/languages": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "reflect-metadata": "catalog:"
  },
  "description": "Console rendering, JSON reporting, and formatting for Conformetry conformance results",
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/conformetry/conformetry-output#readme",
  "keywords": [
    "cli-reporter",
    "conformetry",
    "formatting",
    "output",
    "reporting"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@conformetry/output",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "packages/ic-suite/conformetry/conformetry-output",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.9"
}
