{
  "author": "Jimmy Paolini",
  "bin": {
    "conformetry": "./dist/src/main.js"
  },
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@conformetry/configuration": "workspace:*",
    "@conformetry/generation": "workspace:*",
    "@conformetry/output": "workspace:*",
    "@conformetry/validation": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:ic-suite",
    "nest-commander": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "description": "Command-line toolchain for scaffolding code from templates and holding implementations to them",
  "devDependencies": {
    "@codebase/logger": "workspace:*",
    "@conformetry/core": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/conformetry/conformetry-cli#readme",
  "keywords": [
    "cli",
    "code-generator",
    "conformance",
    "conformetry",
    "nest-commander",
    "scaffolding"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@conformetry/cli",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "packages/ic-suite/conformetry/conformetry-cli",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.3"
}
