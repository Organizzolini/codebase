{
  "author": "Jimmy Paolini",
  "bin": {
    "codependix": "./dist/src/main.js"
  },
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@codependix/boundaries": "workspace:*",
    "@codependix/configuration": "workspace:*",
    "@codependix/core": "workspace:*",
    "@codependix/output": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:ic-suite",
    "nest-commander": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "description": "Command-line tool for exporting and validating Nx, NestJS, and file-level dependency graphs and boundaries",
  "devDependencies": {
    "@codebase/logging": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/codependix/codependix-cli#readme",
  "keywords": [
    "architecture-linter",
    "boundaries",
    "cli",
    "codependix",
    "dependency-graph",
    "mermaid"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@codependix/cli",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "packages/ic-suite/codependix/codependix-cli",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.12"
}
