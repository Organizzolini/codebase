{
  "author": "Jimmy Paolini",
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@callidescope/cli": "workspace:*",
    "@callidescope/configuration": "workspace:*",
    "@callidescope/core": "workspace:*",
    "@callidescope/graph": "workspace:*",
    "@callidescope/output": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "@nestjs/core": "catalog:ic-suite",
    "@nx/devkit": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "description": "Nx plugin providing project-scoped call-stack tracing and depth gating along Nx dependency graphs",
  "devDependencies": {
    "@codebase/logging": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "executors": "./executors.json",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./executors.json": "./executors.json",
    "./package.json": "./package.json",
    "./src/executors/*": "./src/executors/*"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "executors.json",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/callidescope/callidescope-nx#readme",
  "keywords": [
    "call-graph",
    "callidescope",
    "depth-gate",
    "nx",
    "nx-plugin",
    "tracing"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@callidescope/nx",
  "nx": {
    "executors": "./executors.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./executors.json": "./executors.json",
      "./package.json": "./package.json",
      "./src/executors/*": "./dist/src/executors/*.js"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "packages/ic-suite/callidescope/callidescope-nx",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.9"
}
