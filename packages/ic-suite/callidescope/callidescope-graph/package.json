    "reflect-metadata": "catalog:"
  },
  "description": "TypeScript AST call-graph builder and call-stack depth and breadth traversal engine for Callidescope",
  "devDependencies": {
    "@codebase/logger": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/packages/ic-suite/callidescope/callidescope-graph#readme",
  "keywords": [
    "ast",
    "call-graph",
    "callidescope",
    "graph-builder",
    "traversal",
    "typescript"
